  <build>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
        <configuration>
          <excludes>
            <exclude>
              <groupId>org.projectlombok</groupId>
              <artifactId>lombok</artifactId>
            </exclude>
          </excludes>
          <!-- spring-boot:run forks the application JVM. Propagate the same fail-closed live-test
               properties used by Surefire so -Plive-llm-test actually enables the guarded runtime
               after an exact provider-budget reservation is supplied. Packaged production JARs are
               unaffected; the default Maven properties above remain false. -->
          <systemPropertyVariables>
            <executespec.live-llm.enabled>${executespec.live-llm.enabled}</executespec.live-llm.enabled>
            <executespec.live-llm.test-mode>${executespec.live-llm.test-mode}</executespec.live-llm.test-mode>
            <executespec.live-llm.reservation-id>${executespec.live-llm.reservation-id}</executespec.live-llm.reservation-id>
          </systemPropertyVariables>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <configuration>
          <!-- e2e + integration + chaos tests require Docker / live DB / real API
               keys; run via -Pintegration. Default Surefire run = fast unit tests
               only so CI's `mvn package` is bounded to a couple of minutes. -->
          <excludedGroups>e2e,integration,chaos</excludedGroups>
          <!-- CI-minutes (2026-07-22): parallel Surefire forks were TRIED and REVERTED. The win was
               only ~15s (JaCoCo-skip below is the real saving), and forkCount>1 exposed timing-flaky
               tests (tight Thread.sleep + deadline assertions race under CPU contention) AND forced
               10-fork local gates on dev machines. A green-always serial run beats a marginally
               faster flaky one. If revisited, harden every short-sleep timing test first and pin CI
               to forkCount matching the runner's dedicated cores. -->

          <systemPropertyVariables>
            <executespec.live-llm.enabled>${executespec.live-llm.enabled}</executespec.live-llm.enabled>
            <executespec.live-llm.test-mode>${executespec.live-llm.test-mode}</executespec.live-llm.test-mode>
            <executespec.live-llm.reservation-id>${executespec.live-llm.reservation-id}</executespec.live-llm.reservation-id>
          </systemPropertyVariables>
        </configuration>
      </plugin>
      <!-- Google Java Style enforcement via google-java-format.
           `mvn spotless:apply`  → reformats the codebase in place.
           `mvn spotless:check`  → fails the build on drift; wired into
                                   verify so CI catches PRs that skipped it.
           Excluded paths: generated sources + the readymade-stubs catalogue,
           which mirrors customer code style verbatim and must stay byte-identical.
      -->
      <plugin>
        <groupId>com.diffplug.spotless</groupId>
        <artifactId>spotless-maven-plugin</artifactId>
        <!-- 2026-05-16: Dependabot #134 bumped 2.43 → 3.4 (major; config schema unchanged
             for the slots we use: googleJavaFormat, removeUnusedImports, importOrder,
             formatAnnotations). 2026-05-22: Dependabot #149 bumped 3.4 → 3.5.1 (minor;
             google-java-format stays pinned at 1.22.0 below, so the bump changes plugin
             behaviour only — no codebase reformat). -->
        <version>3.5.1</version>
        <configuration>
          <java>
            <includes>
              <include>src/main/java/**/*.java</include>
              <include>src/test/java/**/*.java</include>
            </includes>
            <googleJavaFormat>
              <version>1.22.0</version>
              <style>GOOGLE</style>
              <reflowLongStrings>true</reflowLongStrings>
            </googleJavaFormat>
            <removeUnusedImports/>
            <importOrder>
              <order>java,javax,jakarta,com,org,</order>
            </importOrder>
            <formatAnnotations/>
          </java>
        </configuration>
        <executions>
          <execution>
            <id>spotless-check</id>
            <phase>verify</phase>
            <goals>
              <goal>check</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.jacoco</groupId>
        <artifactId>jacoco-maven-plugin</artifactId>
        <version>0.8.14</version>
        <executions>
          <execution>
            <id>prepare-agent</id>
            <goals><goal>prepare-agent</goal></goals>
            <configuration>
              <!-- The JaCoCo agent appends to jacoco.exec by default. If a test JVM is ever killed
                   mid-write (Ctrl-C, OOM, timeout) the exec file is left truncated, and because
                   every later run appends to it the `report` goal then fails permanently with
                   "Unknown block type 0" on any workspace that isn't cleaned — breaking the build
                   for reasons unrelated to the code. Starting each run from a fresh exec file makes
                   the coverage step self-healing. -->
              <append>false</append>
            </configuration>
          </execution>
          <execution>
            <id>report</id>
            <phase>test</phase>
            <goals><goal>report</goal></goals>
          </execution>
        </executions>
        <configuration>
          <excludes>
            <!-- DTOs / records / generated code add coverage noise without
                 representing real logic; exclude from the headline number. -->
            <exclude>com/navneet/executespec/api/dto/**</exclude>
            <exclude>com/navneet/executespec/**/dto/**</exclude>
            <exclude>com/navneet/executespec/ExecutespecApplication.class</exclude>
          </excludes>
        </configuration>
      </plugin>
    </plugins>
  </build>

  <profiles>
    <!-- CI-minutes (2026-07-22): coverage is off by default (see jacoco.skip in <properties>).
         Run `mvn -Pcoverage test` to instrument + emit target/site/jacoco. -->
    <profile>
      <id>coverage</id>
      <properties>
        <jacoco.skip>false</jacoco.skip>
      </properties>
    </profile>
    <profile>
      <id>integration</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-surefire-plugin</artifactId>
            <configuration>
              <!-- The default build excludes container-backed groups; this explicit profile
                   makes the documented integration command actually execute them. -->
              <excludedGroups>none</excludedGroups>
            </configuration>
          </plugin>
        </plugins>
      </build>
    </profile>
    <profile>
      <id>live-llm-test</id>
      <properties>
        <executespec.live-llm.enabled>true</executespec.live-llm.enabled>
        <executespec.live-llm.test-mode>true</executespec.live-llm.test-mode>
      </properties>
    </profile>
  </profiles>

  <repositories>
    <repository>
      <id>spring-milestones</id>
      <name>Spring Milestones</name>
      <url>https://repo.spring.io/milestone</url>
      <snapshots>
        <enabled>false</enabled>
      </snapshots>
    </repository>
    <repository>
      <id>spring-snapshots</id>
      <name>Spring Snapshots</name>
      <url>https://repo.spring.io/snapshot</url>
      <releases>
        <enabled>false</enabled>
      </releases>
    </repository>
  </repositories>

</project>
