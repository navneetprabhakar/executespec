<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
         https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <!-- 2026-05-16: Dependabot #132 bumped 3.3.0 → 3.5.14 (2 minor versions).
         Spring Boot 3.4/3.5 changes that touch us: Jackson 2.18/2.19 (compatible
         API), Tomcat 11 baseline (we already require Java 21), tightened auto-
         config metadata. Validated by `mvn test` (all 1295 tests pass). -->
    <version>3.5.14</version>
    <relativePath/>
  </parent>

  <groupId>com.navneet</groupId>
  <artifactId>executespec</artifactId>
  <version>2.0.0</version>
  <packaging>jar</packaging>
  <name>executespec</name>
  <description>Spec-driven AI coding platform — spec in, multi-repo PR out, with a verified score</description>

  <licenses>
    <license>
      <name>Apache License, Version 2.0</name>
      <url>https://www.apache.org/licenses/LICENSE-2.0</url>
      <distribution>repo</distribution>
    </license>
  </licenses>

  <properties>
    <java.version>21</java.version>
    <spring-ai.version>1.1.6</spring-ai.version>
    <!-- Override Spring Boot 3.3's Mockito 5.11 → 5.17 for Java 25 compatibility -->
    <mockito.version>5.17.0</mockito.version>
    <!-- Override ByteBuddy 1.14 → 1.16 (officially supports Java 25, class file version 69) -->
    <byte-buddy.version>1.16.1</byte-buddy.version>
    <!-- Unit/default integration tests are fail-closed for provider transports. Live provider
         tests must opt in explicitly and still pass through the goal spend ledger. -->
    <executespec.live-llm.enabled>false</executespec.live-llm.enabled>
    <executespec.live-llm.test-mode>false</executespec.live-llm.test-mode>
    <executespec.live-llm.reservation-id></executespec.live-llm.reservation-id>
    <!-- CI-minutes (2026-07-22): JaCoCo instrumentation + report add real wall-clock to every
         `mvn test`, but coverage is NOT a gate (there is no jacoco:check). Skip it by default so the
         CI PR gate (`mvn spotless:check test`) runs uninstrumented; generate coverage on demand with
         `-Pcoverage`. jacoco-maven-plugin honours the `jacoco.skip` property on both prepare-agent
         and report goals. -->
    <jacoco.skip>true</jacoco.skip>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>org.springframework.ai</groupId>
        <artifactId>spring-ai-bom</artifactId>
        <version>${spring-ai.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

