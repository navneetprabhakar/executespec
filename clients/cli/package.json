{
  "name": "@executespec/cli",
  "version": "0.1.0",
  "private": true,
  "description": "ExecuteSpec CLI — submit specs, watch runs, approve the plan gate, and (local-hands) run against your own working tree. Thin client; the agent loop stays server-side.",
  "type": "module",
  "bin": {
    "executespec": "dist/index.js",
    "es": "dist/index.js"
  },
  "files": ["dist"],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@executespec/core": "*"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.3.0"
  }
}
