# Environment Variables Template
# Copy this file to .env and fill in the values

# ── LLM Provider Keys ────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=your_anthropic_api_key
OPENAI_API_KEY=your_openai_api_key
GOOGLE_API_KEY=your_gemini_api_key

# ── GitHub ────────────────────────────────────────────────────────────────────
# GITHUB_PAT removed 2026-05-23 — no system PAT; each user connects their own PAT in the app (Integrations).
GITHUB_OWNER=your_github_username

# ── Database (Optional - defaults to localhost/postgres) ──────────────────────
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432
# POSTGRES_DB=executespec
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=postgres

# ── Redis (Optional - defaults to localhost:6379) ─────────────────────────────
# REDIS_HOST=localhost

# ── Razorpay (Billing - INR payments) ────────────────────────────────────────
# Test keys: rzp_test_xxx / secret  |  Live keys: rzp_live_xxx / secret
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_key_secret
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret
RAZORPAY_WEBHOOK_URL=http://localhost:8080/api/webhooks/razorpay

# ── Stripe (Billing - USD payments) ──────────────────────────────────────────
# STRIPE_SECRET_KEY=sk_test_xxx
# STRIPE_PUBLISHABLE_KEY=pk_test_xxx
# STRIPE_WEBHOOK_SECRET=whsec_xxx

# ── OAuth2 (Optional) ────────────────────────────────────────────────────────
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=
# GITHUB_OAUTH_CLIENT_ID=
# GITHUB_OAUTH_CLIENT_SECRET=

# ── Slack (Optional) ─────────────────────────────────────────────────────────
# SLACK_CLIENT_ID=
# SLACK_CLIENT_SECRET=
# SLACK_SIGNING_SECRET=
# DASHBOARD_URL=http://localhost:5173
