            "terminalCode",
            "providerCallsDelta",
            "chargeUsdDelta",
            "codeChangesDelta",
            "prCountDelta",
            "evidenceId"
          ],
          "properties": {
            "httpStatus": { "enum": [403, 409] },
            "terminalCode": { "$ref": "#/$defs/nonEmptyString" },
            "providerCallsDelta": { "const": 0 },
            "chargeUsdDelta": { "const": 0 },
            "codeChangesDelta": { "const": 0 },
            "prCountDelta": { "const": 0 },
            "evidenceId": { "$ref": "#/$defs/nonEmptyString" }
          }
        },
        "cwd": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "requestedPath",
            "canonicalPath",
            "realpathBound",
            "headSha",
            "manifestSha256",
            "evidenceId"
          ],
          "properties": {
            "requestedPath": { "$ref": "#/$defs/nonEmptyString" },
            "canonicalPath": { "$ref": "#/$defs/nonEmptyString" },
            "realpathBound": { "const": true },
            "headSha": { "$ref": "#/$defs/gitSha" },
            "manifestSha256": { "$ref": "#/$defs/digest" },
            "evidenceId": { "$ref": "#/$defs/nonEmptyString" }
          }
        },
        "toolPolicy": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "readAllowed",
            "shellDeniedWithoutApproval",
            "mutationDeniedWithoutApproval",
            "explicitApprovalRequired",
            "evidenceId"
          ],
          "properties": {
            "readAllowed": { "const": true },
            "shellDeniedWithoutApproval": { "const": true },
            "mutationDeniedWithoutApproval": { "const": true },
            "explicitApprovalRequired": { "const": true },
            "evidenceId": { "$ref": "#/$defs/nonEmptyString" }
          }
        },
        "verification": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "buildPassed",
            "trackedCliTestsPassed",
            "heavyTuiPassed",
            "windowsSmokePassed",
            "evidenceId"
          ],
          "properties": {
            "buildPassed": { "const": true },
            "trackedCliTestsPassed": { "const": true },
            "heavyTuiPassed": { "const": true },
            "windowsSmokePassed": { "const": true },
            "evidenceId": { "$ref": "#/$defs/nonEmptyString" }
          }
        },
        "parityDigest": { "$ref": "#/$defs/digest" }
      }
    },
    "hero": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ordinal",
        "runId",
        "branch",
        "sourceSha",
        "requestSha256",
        "status",
        "plan",
        "approvalReceiptId",
        "task",
        "files",
        "tests",
        "review",
        "pr",
        "cost",
        "route",
        "physicalCallLedger",
        "longFile",
        "reconnect",
        "parity",
        "terminal",
        "correctnessEvidenceId"
      ],
      "properties": {
        "ordinal": { "type": "integer", "minimum": 1, "maximum": 3 },
        "runId": { "type": "string", "minLength": 1 },
        "branch": { "type": "string", "minLength": 1 },
        "sourceSha": { "$ref": "#/$defs/gitSha" },
        "requestSha256": { "$ref": "#/$defs/digest" },
        "status": { "const": "COMPLETE" },
        "plan": { "$ref": "#/$defs/heroPlan" },
        "approvalReceiptId": { "type": "string", "minLength": 1 },
        "task": { "$ref": "#/$defs/object" },
        "files": { "$ref": "#/$defs/object" },
        "tests": { "$ref": "#/$defs/object" },
        "review": { "$ref": "#/$defs/object" },
        "pr": { "$ref": "#/$defs/object" },
        "cost": { "$ref": "#/$defs/object" },
        "route": { "$ref": "#/$defs/object" },
        "physicalCallLedger": {
          "$ref": "#/$defs/physicalCallLedger"
        },
        "longFile": { "$ref": "#/$defs/object" },
        "reconnect": { "$ref": "#/$defs/object" },
        "parity": { "$ref": "#/$defs/object" },
        "terminal": { "$ref": "#/$defs/object" },
        "correctnessEvidenceId": { "type": "string", "minLength": 1 }
      }
    },
    "heroPlan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "planId",
        "version",
        "fingerprint",
        "strategy",
        "classification",
        "taskCount",
        "evidenceSha256"
      ],
      "properties": {
        "planId": { "$ref": "#/$defs/nonEmptyString" },
        "version": { "type": "integer", "minimum": 1 },
        "fingerprint": { "$ref": "#/$defs/digest" },
        "strategy": { "const": "SINGLE_SHOT" },
        "classification": { "const": "SINGLE_SHOT" },
        "taskCount": { "const": 1 },
        "evidenceSha256": { "$ref": "#/$defs/digest" }
      }
    },
    "physicalCallLedger": {
      "type": "object",
      "additionalProperties": false,
      "required": ["evidenceSha256", "complete", "totalPhysicalAttempts", "calls"],
      "properties": {
        "evidenceSha256": { "$ref": "#/$defs/digest" },
        "complete": { "const": true },
        "totalPhysicalAttempts": { "type": "integer", "minimum": 1 },
        "calls": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/physicalCall" }
        }
      }
    },
    "physicalCall": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "physicalAttemptId",
        "provider",
        "model",
        "feature",
        "agentRole",
        "stepId",
        "attemptStatus",
        "attemptKind",
        "parentAttemptId"
      ],
      "properties": {
        "physicalAttemptId": { "$ref": "#/$defs/nonEmptyString" },
        "provider": { "$ref": "#/$defs/nonEmptyString" },
        "model": { "$ref": "#/$defs/nonEmptyString" },
        "feature": { "$ref": "#/$defs/nonEmptyString" },
        "agentRole": { "$ref": "#/$defs/nonEmptyString" },
        "stepId": { "$ref": "#/$defs/nonEmptyString" },
        "attemptStatus": { "$ref": "#/$defs/nonEmptyString" },
        "attemptKind": { "$ref": "#/$defs/nonEmptyString" },
        "parentAttemptId": {
          "anyOf": [{ "$ref": "#/$defs/nonEmptyString" }, { "type": "null" }]
        }
      }
    },
    "gitSha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "object": {
      "type": "object",
      "additionalProperties": true
    }
  }
}
