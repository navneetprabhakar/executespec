        "attach": {
          "type": "object",
          "additionalProperties": false,
          "required": ["runId", "cursor", "deduplicated", "evidenceId"],
          "properties": {
            "runId": { "$ref": "#/$defs/nonEmptyString" },
            "cursor": { "$ref": "#/$defs/nonEmptyString" },
            "deduplicated": { "const": true },
            "evidenceId": { "$ref": "#/$defs/nonEmptyString" }
          }
        },
        "sigint": {
          "type": "object",
