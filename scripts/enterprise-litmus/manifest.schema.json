{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://executespec.ai/schemas/enterprise-litmus-manifest-v4.json",
  "title": "ExecuteSpec enterprise litmus manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "campaignId",
    "state",
    "createdAt",
    "updatedAt",
    "invalidation",
    "deployment",
    "fixture",
    "project",
    "route",
    "runRequest",
    "approval",
    "clients",
    "sandboxJourney",
    "cliFallback",
    "frozenTupleDigest",
    "heroes",
    "postMerge",
    "negatives",
    "cleanup",
    "events"
  ],
  "properties": {
    "schemaVersion": {
      "const": 4
    },
    "campaignId": {
      "type": "string",
      "minLength": 1
    },
    "state": {
      "enum": [
        "NEW",
        "PREFLIGHTED",
        "FIXTURE_CREATED",
        "PROJECT_LINKED",
        "SANDBOX_ASSESSED",
        "BASELINE_V1_READY",
        "SOURCE_REVISION_PUSHED",
        "BASELINE_V2_READY",
        "FROZEN",
        "HERO_1_RUNNING",
        "HERO_1_VERIFIED",
        "HERO_2_RUNNING",
        "HERO_2_VERIFIED",
        "HERO_3_RUNNING",
        "HERO_3_VERIFIED",
        "CLI_FALLBACK_VERIFIED",
        "HERO_PR_MERGED",
        "MERGED_SHA_REFRESHED",
        "CONTINUATION_VERIFIED",
        "CI_FAILURE_CREATED",
        "CI_FIX_VERIFIED",
        "DEPLOYMENT_TRACKED",
        "DEPLOYMENT_SKIPPED",
        "NEGATIVES_VERIFIED",
        "CLEANUP_REQUIRED",
        "CLEANUP_VERIFIED",
        "COMPLETE",
        "INVALIDATED"
      ]
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "invalidation": {
      "type": ["object", "null"]
    },
    "deployment": {
      "$ref": "#/$defs/object"
    },
    "fixture": {
      "$ref": "#/$defs/object"
    },
    "project": {
      "$ref": "#/$defs/object"
    },
    "route": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "model", "routingMode"],
      "properties": {
        "provider": {
          "enum": ["DEEPSEEK", "FIREWORKS"]
        },
        "model": {
          "enum": [
            "deepseek-v4-pro-native",
            "deepseek-v4-flash-native",
            "glm-5.2-fw"
          ]
        },
        "routingMode": {
          "const": "EXACT_LOCK"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "provider": {
                "const": "FIREWORKS"
              }
            }
          },
          "then": {
            "properties": {
              "model": {
                "const": "glm-5.2-fw"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "provider": {
                "const": "DEEPSEEK"
              }
            }
          },
          "then": {
            "properties": {
              "model": {
                "enum": ["deepseek-v4-pro-native", "deepseek-v4-flash-native"]
              }
            }
          }
        }
      ]
    },
    "runRequest": {
      "$ref": "#/$defs/object"
    },
    "approval": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "fingerprintAlgorithm",
        "fingerprintRequired",
        "creditsConfirmationRequired",
        "decisionContractSha256"
      ],
      "properties": {
        "mode": {
          "const": "MANUAL_EXACT_PLAN"
        },
        "fingerprintAlgorithm": {
          "const": "SHA-256_UTF8_PLAN_JSON"
        },
        "fingerprintRequired": {
          "const": true
        },
        "creditsConfirmationRequired": {
          "const": true
        },
        "decisionContractSha256": {
          "type": "string",
          "pattern": "^(|[0-9a-f]{64})$"
        }
      }
    },
    "clients": {
      "$ref": "#/$defs/object"
    },
    "sandboxJourney": {
      "oneOf": [
        { "$ref": "#/$defs/emptyObject" },
        { "$ref": "#/$defs/sandboxJourney" }
      ]
    },
    "cliFallback": {
      "oneOf": [
        { "$ref": "#/$defs/emptyObject" },
        { "$ref": "#/$defs/cliFallback" }
      ]
    },
    "frozenTupleDigest": {
      "type": ["string", "null"],
      "pattern": "^[0-9a-f]{64}$"
    },
    "heroes": {
      "type": "array",
      "maxItems": 3,
      "items": {
        "$ref": "#/$defs/hero"
      }
    },
    "postMerge": {
      "$ref": "#/$defs/object"
    },
    "negatives": {
      "type": "array",
      "maxItems": 21,
      "items": {
        "$ref": "#/$defs/object"
      }
    },
    "cleanup": {
      "$ref": "#/$defs/object"
    },
    "events": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/object"
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "state": {
            "enum": [
              "SANDBOX_ASSESSED",
              "BASELINE_V1_READY",
              "SOURCE_REVISION_PUSHED",
              "BASELINE_V2_READY",
              "FROZEN",
              "HERO_1_RUNNING",
              "HERO_1_VERIFIED",
              "HERO_2_RUNNING",
              "HERO_2_VERIFIED",
              "HERO_3_RUNNING",
              "HERO_3_VERIFIED",
              "CLI_FALLBACK_VERIFIED",
              "HERO_PR_MERGED",
              "MERGED_SHA_REFRESHED",
              "CONTINUATION_VERIFIED",
              "CI_FAILURE_CREATED",
              "CI_FIX_VERIFIED",
              "DEPLOYMENT_TRACKED",
              "DEPLOYMENT_SKIPPED",
              "NEGATIVES_VERIFIED",
              "COMPLETE"
            ]
          }
        },
        "required": ["state"]
      },
      "then": {
        "properties": {
          "sandboxJourney": { "$ref": "#/$defs/sandboxJourney" }
        }
      }
    },
    {
      "if": {
        "properties": {
          "state": {
            "enum": [
              "CLI_FALLBACK_VERIFIED",
              "HERO_PR_MERGED",
              "MERGED_SHA_REFRESHED",
              "CONTINUATION_VERIFIED",
              "CI_FAILURE_CREATED",
              "CI_FIX_VERIFIED",
              "DEPLOYMENT_TRACKED",
              "DEPLOYMENT_SKIPPED",
              "NEGATIVES_VERIFIED",
              "COMPLETE"
            ]
          }
        },
        "required": ["state"]
      },
      "then": {
        "properties": {
          "cliFallback": { "$ref": "#/$defs/cliFallback" }
        }
      }
    },
    {
      "if": {
        "properties": {
          "state": {
            "enum": [
              "NEW",
              "PREFLIGHTED",
              "FIXTURE_CREATED",
              "PROJECT_LINKED",
              "SANDBOX_ASSESSED",
              "BASELINE_V1_READY",
              "SOURCE_REVISION_PUSHED",
              "BASELINE_V2_READY",
              "FROZEN"
            ]
          }
        },
        "required": ["state"]
      },
      "then": { "$ref": "#/$defs/evidenceEmpty" }
    },
    {
      "if": {
        "properties": { "state": { "const": "HERO_1_RUNNING" } },
        "required": ["state"]
      },
      "then": { "$ref": "#/$defs/evidenceHero1Pending" }
    },
    {
      "if": {
        "properties": { "state": { "const": "HERO_1_VERIFIED" } },
        "required": ["state"]
      },
      "then": { "$ref": "#/$defs/evidenceHero1Verified" }
    },
    {
      "if": {
        "properties": { "state": { "const": "HERO_2_RUNNING" } },
        "required": ["state"]
      },
      "then": { "$ref": "#/$defs/evidenceHero2Pending" }
    },
    {
      "if": {
        "properties": { "state": { "const": "HERO_2_VERIFIED" } },
        "required": ["state"]
      },
      "then": { "$ref": "#/$defs/evidenceHero2Verified" }
    },
    {
      "if": {
        "properties": { "state": { "const": "HERO_3_RUNNING" } },
        "required": ["state"]
      },
      "then": { "$ref": "#/$defs/evidenceHero3Pending" }
    },
    {
      "if": {
        "properties": {
          "state": { "enum": ["HERO_3_VERIFIED", "CLI_FALLBACK_VERIFIED"] }
        },
        "required": ["state"]
      },
      "then": { "$ref": "#/$defs/evidenceHero3Verified" }
    },
    {
      "if": {
        "properties": { "state": { "const": "HERO_PR_MERGED" } },
        "required": ["state"]
      },
      "then": { "$ref": "#/$defs/evidenceHeroPrMerged" }
    },
    {
      "if": {
        "properties": { "state": { "const": "MERGED_SHA_REFRESHED" } },
        "required": ["state"]
      },
      "then": { "$ref": "#/$defs/evidenceMergedShaRefreshed" }
    },
    {
      "if": {
        "properties": { "state": { "const": "CONTINUATION_VERIFIED" } },
        "required": ["state"]
      },
      "then": { "$ref": "#/$defs/evidenceContinuationVerified" }
    },
    {
      "if": {
        "properties": { "state": { "const": "CI_FAILURE_CREATED" } },
        "required": ["state"]
      },
      "then": { "$ref": "#/$defs/evidenceCiFailureCreated" }
    },
    {
      "if": {
        "properties": { "state": { "const": "CI_FIX_VERIFIED" } },
        "required": ["state"]
      },
      "then": { "$ref": "#/$defs/evidenceCiFixVerified" }
    },
    {
      "if": {
        "properties": {
          "state": { "enum": ["DEPLOYMENT_TRACKED", "DEPLOYMENT_SKIPPED"] }
        },
        "required": ["state"]
      },
      "then": { "$ref": "#/$defs/evidenceDeploymentResolved" }
    },
    {
      "if": {
        "properties": {
          "state": { "enum": ["NEGATIVES_VERIFIED", "COMPLETE"] }
        },
        "required": ["state"]
      },
      "then": { "$ref": "#/$defs/evidenceNegativesVerified" }
    },
    {
      "if": {
        "properties": { "state": { "const": "CLEANUP_REQUIRED" } },
        "required": ["state"]
      },
      "then": {
        "properties": {
          "cleanup": {
            "type": "object",
            "required": ["required"],
            "properties": {
              "required": { "$ref": "#/$defs/cleanupRequiredBoundary" }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": { "state": { "const": "CLEANUP_VERIFIED" } },
        "required": ["state"]
      },
      "then": {
        "properties": {
          "cleanup": {
            "type": "object",
            "required": ["required", "verified"],
            "properties": {
              "required": { "$ref": "#/$defs/cleanupRequiredBoundary" },
              "verified": { "$ref": "#/$defs/cleanupVerifiedEvidence" }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": { "state": { "const": "COMPLETE" } },
        "required": ["state"]
      },
      "then": {
        "properties": {
          "cleanup": { "$ref": "#/$defs/completeCleanup" }
        }
      }
    },
    {
      "if": {
        "properties": { "state": { "const": "INVALIDATED" } },
        "required": ["state"]
      },
      "then": {
        "properties": {
          "invalidation": { "$ref": "#/$defs/invalidationBoundary" }
        }
      }
    }
  ],
  "$defs": {
    "nonEmptyString": { "type": "string", "minLength": 1 },
    "emptyObject": {
      "type": "object",
      "additionalProperties": false,
      "maxProperties": 0
    },
    "heroSubmission": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ordinal",
        "runId",
        "branch",
        "sourceSha",
        "requestSha256",
        "submittedEvidenceId"
      ],
      "properties": {
        "ordinal": { "type": "integer", "minimum": 1, "maximum": 3 },
        "runId": { "$ref": "#/$defs/nonEmptyString" },
        "branch": { "$ref": "#/$defs/nonEmptyString" },
        "sourceSha": { "$ref": "#/$defs/gitSha" },
        "requestSha256": { "$ref": "#/$defs/digest" },
        "submittedEvidenceId": { "$ref": "#/$defs/nonEmptyString" }
      }
    },
    "heroSubmission1": {
      "allOf": [
        { "$ref": "#/$defs/heroSubmission" },
        { "properties": { "ordinal": { "const": 1 } } }
      ]
    },
    "heroSubmission2": {
      "allOf": [
        { "$ref": "#/$defs/heroSubmission" },
        { "properties": { "ordinal": { "const": 2 } } }
      ]
    },
    "heroSubmission3": {
      "allOf": [
        { "$ref": "#/$defs/heroSubmission" },
        { "properties": { "ordinal": { "const": 3 } } }
      ]
    },
    "heroSubmissions1": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "prefixItems": [{ "$ref": "#/$defs/heroSubmission1" }],
      "items": false
    },
    "heroSubmissions2": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "prefixItems": [
        { "$ref": "#/$defs/heroSubmission1" },
        { "$ref": "#/$defs/heroSubmission2" }
      ],
      "items": false
    },
    "heroSubmissions3": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "prefixItems": [
        { "$ref": "#/$defs/heroSubmission1" },
        { "$ref": "#/$defs/heroSubmission2" },
        { "$ref": "#/$defs/heroSubmission3" }
      ],
      "items": false
    },
    "postMergePending1": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pendingHero"],
      "properties": {
        "pendingHero": { "$ref": "#/$defs/heroSubmission1" }
      }
    },
    "postMergeSubmissions1": {
      "type": "object",
      "additionalProperties": false,
      "required": ["heroSubmissions"],
      "properties": {
        "heroSubmissions": { "$ref": "#/$defs/heroSubmissions1" }
      }
    },
    "postMergeSubmissions1Pending2": {
      "type": "object",
      "additionalProperties": false,
      "required": ["heroSubmissions", "pendingHero"],
      "properties": {
        "heroSubmissions": { "$ref": "#/$defs/heroSubmissions1" },
        "pendingHero": { "$ref": "#/$defs/heroSubmission2" }
      }
    },
    "postMergeSubmissions2": {
      "type": "object",
      "additionalProperties": false,
      "required": ["heroSubmissions"],
      "properties": {
        "heroSubmissions": { "$ref": "#/$defs/heroSubmissions2" }
      }
    },
    "postMergeSubmissions2Pending3": {
      "type": "object",
      "additionalProperties": false,
      "required": ["heroSubmissions", "pendingHero"],
      "properties": {
        "heroSubmissions": { "$ref": "#/$defs/heroSubmissions2" },
        "pendingHero": { "$ref": "#/$defs/heroSubmission3" }
      }
    },
    "postMergeSubmissions3": {
      "type": "object",
      "additionalProperties": false,
      "required": ["heroSubmissions"],
      "properties": {
        "heroSubmissions": { "$ref": "#/$defs/heroSubmissions3" }
      }
    },
    "postMergeMerged": {
      "type": "object",
      "additionalProperties": false,
      "required": ["heroSubmissions", "merge"],
      "properties": {
        "heroSubmissions": { "$ref": "#/$defs/heroSubmissions3" },
        "merge": { "$ref": "#/$defs/object" }
      }
    },
    "postMergeRefreshed": {
      "type": "object",
      "additionalProperties": false,
      "required": ["heroSubmissions", "merge", "refresh"],
      "properties": {
        "heroSubmissions": { "$ref": "#/$defs/heroSubmissions3" },
        "merge": { "$ref": "#/$defs/object" },
        "refresh": { "$ref": "#/$defs/object" }
      }
    },
    "postMergeContinuation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["heroSubmissions", "merge", "refresh", "continuation"],
      "properties": {
        "heroSubmissions": { "$ref": "#/$defs/heroSubmissions3" },
        "merge": { "$ref": "#/$defs/object" },
        "refresh": { "$ref": "#/$defs/object" },
        "continuation": { "$ref": "#/$defs/object" }
      }
    },
    "postMergeCiFailure": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "heroSubmissions",
        "merge",
        "refresh",
        "continuation",
        "ciFailure"
      ],
      "properties": {
        "heroSubmissions": { "$ref": "#/$defs/heroSubmissions3" },
        "merge": { "$ref": "#/$defs/object" },
        "refresh": { "$ref": "#/$defs/object" },
        "continuation": { "$ref": "#/$defs/object" },
        "ciFailure": { "$ref": "#/$defs/object" }
      }
    },
    "postMergeCiFix": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "heroSubmissions",
        "merge",
        "refresh",
        "continuation",
        "ciFailure",
        "ciFix"
      ],
      "properties": {
        "heroSubmissions": { "$ref": "#/$defs/heroSubmissions3" },
        "merge": { "$ref": "#/$defs/object" },
        "refresh": { "$ref": "#/$defs/object" },
        "continuation": { "$ref": "#/$defs/object" },
        "ciFailure": { "$ref": "#/$defs/object" },
        "ciFix": { "$ref": "#/$defs/object" }
      }
    },
    "postMergeDeployment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "heroSubmissions",
        "merge",
        "refresh",
        "continuation",
        "ciFailure",
        "ciFix",
        "deployment"
      ],
      "properties": {
        "heroSubmissions": { "$ref": "#/$defs/heroSubmissions3" },
        "merge": { "$ref": "#/$defs/object" },
        "refresh": { "$ref": "#/$defs/object" },
        "continuation": { "$ref": "#/$defs/object" },
        "ciFailure": { "$ref": "#/$defs/object" },
        "ciFix": { "$ref": "#/$defs/object" },
        "deployment": { "$ref": "#/$defs/object" }
      }
    },
    "evidenceEmpty": {
      "properties": {
        "heroes": { "maxItems": 0 },
        "postMerge": { "$ref": "#/$defs/emptyObject" },
        "negatives": { "maxItems": 0 }
      }
    },
    "evidenceHero1Pending": {
      "properties": {
        "heroes": { "maxItems": 0 },
        "postMerge": { "$ref": "#/$defs/postMergePending1" },
        "negatives": { "maxItems": 0 }
      }
    },
    "evidenceHero1Verified": {
      "properties": {
        "heroes": { "minItems": 1, "maxItems": 1 },
        "postMerge": { "$ref": "#/$defs/postMergeSubmissions1" },
        "negatives": { "maxItems": 0 }
      }
    },
    "evidenceHero2Pending": {
      "properties": {
        "heroes": { "minItems": 1, "maxItems": 1 },
        "postMerge": { "$ref": "#/$defs/postMergeSubmissions1Pending2" },
        "negatives": { "maxItems": 0 }
      }
    },
    "evidenceHero2Verified": {
      "properties": {
        "heroes": { "minItems": 2, "maxItems": 2 },
        "postMerge": { "$ref": "#/$defs/postMergeSubmissions2" },
        "negatives": { "maxItems": 0 }
      }
    },
    "evidenceHero3Pending": {
      "properties": {
        "heroes": { "minItems": 2, "maxItems": 2 },
        "postMerge": { "$ref": "#/$defs/postMergeSubmissions2Pending3" },
        "negatives": { "maxItems": 0 }
      }
    },
    "evidenceHero3Verified": {
      "properties": {
        "heroes": { "minItems": 3, "maxItems": 3 },
        "postMerge": { "$ref": "#/$defs/postMergeSubmissions3" },
        "negatives": { "maxItems": 0 }
      }
    },
    "evidenceHeroPrMerged": {
      "properties": {
        "heroes": { "minItems": 3, "maxItems": 3 },
        "postMerge": { "$ref": "#/$defs/postMergeMerged" },
        "negatives": { "maxItems": 0 }
      }
    },
    "evidenceMergedShaRefreshed": {
      "properties": {
        "heroes": { "minItems": 3, "maxItems": 3 },
        "postMerge": { "$ref": "#/$defs/postMergeRefreshed" },
        "negatives": { "maxItems": 0 }
      }
    },
    "evidenceContinuationVerified": {
      "properties": {
        "heroes": { "minItems": 3, "maxItems": 3 },
        "postMerge": { "$ref": "#/$defs/postMergeContinuation" },
        "negatives": { "maxItems": 0 }
      }
    },
    "evidenceCiFailureCreated": {
      "properties": {
        "heroes": { "minItems": 3, "maxItems": 3 },
        "postMerge": { "$ref": "#/$defs/postMergeCiFailure" },
        "negatives": { "maxItems": 0 }
      }
    },
    "evidenceCiFixVerified": {
      "properties": {
        "heroes": { "minItems": 3, "maxItems": 3 },
        "postMerge": { "$ref": "#/$defs/postMergeCiFix" },
        "negatives": { "maxItems": 0 }
      }
    },
    "evidenceDeploymentResolved": {
      "properties": {
        "heroes": { "minItems": 3, "maxItems": 3 },
        "postMerge": { "$ref": "#/$defs/postMergeDeployment" },
        "negatives": { "maxItems": 0 }
      }
    },
    "evidenceNegativesVerified": {
      "properties": {
        "heroes": { "minItems": 3, "maxItems": 3 },
        "postMerge": { "$ref": "#/$defs/postMergeDeployment" },
        "negatives": { "minItems": 21, "maxItems": 21 }
      }
    },
    "evidenceOriginState": {
      "enum": [
        "NEW",
        "PREFLIGHTED",
        "FIXTURE_CREATED",
        "PROJECT_LINKED",
        "SANDBOX_ASSESSED",
        "BASELINE_V1_READY",
        "SOURCE_REVISION_PUSHED",
        "BASELINE_V2_READY",
        "FROZEN",
        "HERO_1_RUNNING",
        "HERO_1_VERIFIED",
        "HERO_2_RUNNING",
        "HERO_2_VERIFIED",
        "HERO_3_RUNNING",
        "HERO_3_VERIFIED",
        "CLI_FALLBACK_VERIFIED",
        "HERO_PR_MERGED",
        "MERGED_SHA_REFRESHED",
        "CONTINUATION_VERIFIED",
        "CI_FAILURE_CREATED",
        "CI_FIX_VERIFIED",
        "DEPLOYMENT_TRACKED",
        "DEPLOYMENT_SKIPPED",
        "NEGATIVES_VERIFIED",
        "COMPLETE"
      ]
    },
    "cleanupRequiredBoundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reason",
        "cleanupPlanId",
        "enteredFromState",
        "heroCountAtEntry",
        "stateEvidenceDigest"
      ],
      "properties": {
        "reason": { "$ref": "#/$defs/nonEmptyString" },
        "cleanupPlanId": { "$ref": "#/$defs/nonEmptyString" },
        "enteredFromState": { "$ref": "#/$defs/evidenceOriginState" },
        "heroCountAtEntry": { "type": "integer", "minimum": 0, "maximum": 3 },
