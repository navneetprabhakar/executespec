{
  "id": "minimal-light",
  "name": "Minimal Light",
  "description": "Light mode, clean, SaaS default",
  "tailwind": {
    "colors": {
      "primary": "zinc-900",
      "primary-foreground": "white",
      "background": "white",
      "foreground": "zinc-900",
      "card": "white",
      "card-foreground": "zinc-900",
      "muted": "zinc-100",
      "muted-foreground": "zinc-500",
      "accent": "zinc-100",
      "accent-foreground": "zinc-900",
      "destructive": "red-500",
      "border": "zinc-200",
      "input": "zinc-200",
      "ring": "zinc-400"
    },
    "borderRadius": "rounded-lg",
    "fontFamily": "Inter, system-ui, sans-serif"
  },
  "shadcn": {
    "cssVariables": {
      "--background": "0 0% 100%",
      "--foreground": "240 10% 3.9%",
      "--card": "0 0% 100%",
      "--card-foreground": "240 10% 3.9%",
      "--popover": "0 0% 100%",
      "--popover-foreground": "240 10% 3.9%",
      "--primary": "240 5.9% 10%",
      "--primary-foreground": "0 0% 98%",
      "--secondary": "240 4.8% 95.9%",
      "--secondary-foreground": "240 5.9% 10%",
      "--muted": "240 4.8% 95.9%",
      "--muted-foreground": "240 3.8% 46.1%",
      "--accent": "240 4.8% 95.9%",
      "--accent-foreground": "240 5.9% 10%",
      "--destructive": "0 84.2% 60.2%",
      "--destructive-foreground": "0 0% 98%",
      "--border": "240 5.9% 90%",
      "--input": "240 5.9% 90%",
      "--ring": "240 5.9% 10%",
      "--radius": "0.5rem"
    }
  },
  "density": "comfortable",
  "darkMode": false
}
