{
  "id": "minimal-dark",
  "name": "Minimal Dark",
  "description": "Dark mode, clean, developer-facing",
  "tailwind": {
    "colors": {
      "primary": "slate-50",
      "primary-foreground": "zinc-950",
      "background": "zinc-950",
      "foreground": "slate-50",
      "card": "zinc-900",
      "card-foreground": "slate-50",
      "muted": "zinc-800",
      "muted-foreground": "zinc-400",
      "accent": "zinc-800",
      "accent-foreground": "slate-50",
      "destructive": "red-500",
      "border": "zinc-800",
      "input": "zinc-800",
      "ring": "slate-300"
    },
    "borderRadius": "rounded-lg",
    "fontFamily": "Inter, system-ui, sans-serif"
  },
  "shadcn": {
    "cssVariables": {
      "--background": "240 10% 3.9%",
      "--foreground": "0 0% 98%",
      "--card": "240 10% 3.9%",
      "--card-foreground": "0 0% 98%",
      "--popover": "240 10% 3.9%",
      "--popover-foreground": "0 0% 98%",
      "--primary": "0 0% 98%",
      "--primary-foreground": "240 5.9% 10%",
      "--secondary": "240 3.7% 15.9%",
      "--secondary-foreground": "0 0% 98%",
      "--muted": "240 3.7% 15.9%",
      "--muted-foreground": "240 5% 64.9%",
      "--accent": "240 3.7% 15.9%",
      "--accent-foreground": "0 0% 98%",
      "--destructive": "0 62.8% 30.6%",
      "--destructive-foreground": "0 0% 98%",
      "--border": "240 3.7% 15.9%",
      "--input": "240 3.7% 15.9%",
      "--ring": "240 4.9% 83.9%",
      "--radius": "0.5rem"
    }
  },
  "density": "comfortable",
  "darkMode": true
}
