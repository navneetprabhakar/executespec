{
  "uid": "executespec-overview",
  "title": "ExecuteSpec — Overview",
  "tags": ["executespec"],
  "timezone": "browser",
  "refresh": "10s",
  "time": { "from": "now-1h", "to": "now" },
  "templating": { "list": [] },
  "panels": [
    {
      "id": 1,
      "title": "Active Runs",
      "type": "stat",
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 0 },
      "targets": [{ "expr": "executespec_run_active", "refId": "A" }],
      "fieldConfig": { "defaults": { "thresholds": { "steps": [{"color": "green", "value": null}, {"color": "yellow", "value": 2}, {"color": "red", "value": 5}] } } }
    },
    {
      "id": 2,
      "title": "Queued Runs",
      "type": "stat",
      "gridPos": { "h": 4, "w": 4, "x": 4, "y": 0 },
      "targets": [{ "expr": "executespec_run_queued", "refId": "A" }],
      "fieldConfig": { "defaults": { "thresholds": { "steps": [{"color": "green", "value": null}, {"color": "yellow", "value": 3}, {"color": "red", "value": 10}] } } }
    },
    {
      "id": 3,
      "title": "Active Previews",
      "type": "stat",
      "gridPos": { "h": 4, "w": 4, "x": 8, "y": 0 },
      "targets": [{ "expr": "executespec_preview_active", "refId": "A" }],
      "fieldConfig": { "defaults": { "thresholds": { "steps": [{"color": "green", "value": null}, {"color": "yellow", "value": 3}] } } }
    },
    {
      "id": 4,
      "title": "Active Deploys",
      "type": "stat",
      "gridPos": { "h": 4, "w": 4, "x": 12, "y": 0 },
      "targets": [{ "expr": "executespec_deploy_active", "refId": "A" }],
      "fieldConfig": { "defaults": { "thresholds": { "steps": [{"color": "green", "value": null}, {"color": "yellow", "value": 2}] } } }
    },
    {
      "id": 5,
      "title": "Runs — Total (by status)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "targets": [{ "expr": "increase(executespec_run_total_total[5m])", "legendFormat": "{{status}}", "refId": "A" }],
      "fieldConfig": { "defaults": { "custom": { "fillOpacity": 20 } } }
    },
    {
      "id": 6,
      "title": "Run Duration (p50 / p95 / p99)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "targets": [
        { "expr": "histogram_quantile(0.5, rate(executespec_run_duration_seconds_bucket[5m]))", "legendFormat": "p50", "refId": "A" },
        { "expr": "histogram_quantile(0.95, rate(executespec_run_duration_seconds_bucket[5m]))", "legendFormat": "p95", "refId": "B" },
        { "expr": "histogram_quantile(0.99, rate(executespec_run_duration_seconds_bucket[5m]))", "legendFormat": "p99", "refId": "C" }
      ],
      "fieldConfig": { "defaults": { "unit": "s" } }
    },
    {
      "id": 7,
      "title": "LLM Calls (by provider / model)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 12 },
      "targets": [{ "expr": "increase(executespec_llm_calls_total[5m])", "legendFormat": "{{provider}} / {{model}}", "refId": "A" }],
      "fieldConfig": { "defaults": { "custom": { "fillOpacity": 15 } } }
    },
    {
      "id": 8,
      "title": "LLM Call Latency (by provider / model)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 12 },
      "targets": [
        { "expr": "histogram_quantile(0.5, rate(executespec_llm_duration_seconds_bucket[5m]))", "legendFormat": "p50 {{provider}}/{{model}}", "refId": "A" },
        { "expr": "histogram_quantile(0.95, rate(executespec_llm_duration_seconds_bucket[5m]))", "legendFormat": "p95 {{provider}}/{{model}}", "refId": "B" }
      ],
      "fieldConfig": { "defaults": { "unit": "s" } }
    },
    {
      "id": 9,
      "title": "LLM Token Usage (input / output)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 20 },
      "targets": [
        { "expr": "increase(executespec_llm_tokens_input_total[5m])", "legendFormat": "input — {{provider}}/{{model}}", "refId": "A" },
        { "expr": "increase(executespec_llm_tokens_output_total[5m])", "legendFormat": "output — {{provider}}/{{model}}", "refId": "B" }
      ]
    },
    {
      "id": 10,
      "title": "LLM Errors & Fallbacks",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 20 },
      "targets": [
        { "expr": "increase(executespec_llm_errors_total[5m])", "legendFormat": "errors — {{provider}}", "refId": "A" },
        { "expr": "increase(executespec_llm_fallback_total[5m])", "legendFormat": "fallback — {{from}} → {{to}}", "refId": "B" }
      ]
    },
    {
      "id": 11,
      "title": "Task Duration (p50 / p95)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 28 },
      "targets": [
        { "expr": "histogram_quantile(0.5, rate(executespec_task_duration_seconds_bucket[5m]))", "legendFormat": "p50", "refId": "A" },
        { "expr": "histogram_quantile(0.95, rate(executespec_task_duration_seconds_bucket[5m]))", "legendFormat": "p95", "refId": "B" }
      ],
      "fieldConfig": { "defaults": { "unit": "s" } }
    },
    {
      "id": 12,
      "title": "Agent Handover Duration",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 28 },
      "targets": [
        { "expr": "histogram_quantile(0.5, rate(executespec_handover_duration_seconds_bucket[5m]))", "legendFormat": "p50 — {{from_phase}} → {{to_phase}}", "refId": "A" },
        { "expr": "histogram_quantile(0.95, rate(executespec_handover_duration_seconds_bucket[5m]))", "legendFormat": "p95 — {{from_phase}} → {{to_phase}}", "refId": "B" }
      ],
      "fieldConfig": { "defaults": { "unit": "s" } }
    },
    {
      "id": 13,
      "title": "Gate Wait Times",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 36 },
      "targets": [
        { "expr": "histogram_quantile(0.5, rate(executespec_gate_wait_time_seconds_bucket[5m]))", "legendFormat": "p50 — {{gate}}", "refId": "A" },
        { "expr": "histogram_quantile(0.95, rate(executespec_gate_wait_time_seconds_bucket[5m]))", "legendFormat": "p95 — {{gate}}", "refId": "B" }
      ],
      "fieldConfig": { "defaults": { "unit": "s" } }
    },
    {
      "id": 14,
      "title": "Tool Calls (by tool name)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 36 },
      "targets": [{ "expr": "increase(executespec_tool_calls_total[5m])", "legendFormat": "{{tool}}", "refId": "A" }],
      "fieldConfig": { "defaults": { "custom": { "fillOpacity": 15 } } }
    },
    {
      "id": 15,
      "title": "Preview — Build & Deploy Duration",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 44 },
      "targets": [
        { "expr": "histogram_quantile(0.5, rate(executespec_preview_build_duration_seconds_bucket[5m]))", "legendFormat": "build p50", "refId": "A" },
        { "expr": "histogram_quantile(0.5, rate(executespec_preview_deploy_duration_seconds_bucket[5m]))", "legendFormat": "deploy p50", "refId": "B" },
        { "expr": "histogram_quantile(0.95, rate(executespec_preview_build_duration_seconds_bucket[5m]))", "legendFormat": "build p95", "refId": "C" },
        { "expr": "histogram_quantile(0.95, rate(executespec_preview_deploy_duration_seconds_bucket[5m]))", "legendFormat": "deploy p95", "refId": "D" }
      ],
      "fieldConfig": { "defaults": { "unit": "s" } }
    },
    {
      "id": 16,
      "title": "Deploy — Build & Health Check Duration",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 44 },
      "targets": [
        { "expr": "histogram_quantile(0.5, rate(executespec_deploy_build_duration_seconds_bucket[5m]))", "legendFormat": "build p50", "refId": "A" },
        { "expr": "histogram_quantile(0.5, rate(executespec_deploy_health_check_duration_seconds_bucket[5m]))", "legendFormat": "health-check p50", "refId": "B" },
        { "expr": "histogram_quantile(0.95, rate(executespec_deploy_build_duration_seconds_bucket[5m]))", "legendFormat": "build p95", "refId": "C" },
        { "expr": "histogram_quantile(0.95, rate(executespec_deploy_health_check_duration_seconds_bucket[5m]))", "legendFormat": "health-check p95", "refId": "D" }
      ],
      "fieldConfig": { "defaults": { "unit": "s" } }
    },
    {
      "id": 17,
      "title": "Preview & Deploy Failures",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 52 },
      "targets": [
        { "expr": "increase(executespec_preview_failures_total[5m])", "legendFormat": "preview failures", "refId": "A" },
        { "expr": "increase(executespec_deploy_failures_total[5m])", "legendFormat": "deploy failures", "refId": "B" }
      ]
    },
    {
      "id": 18,
      "title": "Stuck Runs Detected",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 52 },
      "targets": [{ "expr": "increase(executespec_monitor_stuck_detected_total[5m])", "legendFormat": "stuck detected", "refId": "A" }]
    }
  ],
  "schemaVersion": 39
}
