{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://executespec.ai/schemas/benchmark-manifest-v1.json",
  "title": "ExecuteSpec benchmark manifest",
  "type": "object",
  "required": [
    "schemaVersion",
    "status",
    "suite",
    "repository",
    "model",
    "prompt",
    "toolSchema",
    "harness",
    "dataset",
    "featureFlags",
    "budgets",
    "results"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "status": {
      "enum": ["REPRODUCIBLE", "EXPLORATORY", "EXPLORATORY_RETROSPECTIVE", "SUPERSEDED", "INVALID"]
    },
    "suite": { "type": "string", "minLength": 1 },
    "repository": {
      "type": "object",
      "required": ["sha"],
      "properties": { "sha": { "type": ["string", "null"], "pattern": "^[a-f0-9]{64}$" }, "shaRange": { "type": ["string", "null"] } }
    },
    "model": {
      "type": "object",
      "required": ["provider", "matrixId", "providerSlug"],
      "properties": {
        "provider": { "type": "string" },
        "matrixId": { "type": "string" },
        "providerSlug": { "type": ["string", "null"], "pattern": "^[a-z0-9][a-z0-9._:/-]*$" }
      }
    },
    "prompt": { "$ref": "#/$defs/identity" },
    "toolSchema": { "$ref": "#/$defs/identity" },
    "harness": { "$ref": "#/$defs/identity" },
    "dataset": {
      "type": "object",
      "required": ["name", "slice", "sha256"],
      "properties": {
        "name": { "type": "string" },
        "slice": { "type": "string" },
        "sha256": { "type": ["string", "null"], "pattern": "^[a-f0-9]{64}$" }
      }
    },
    "featureFlags": { "type": "object" },
    "budgets": { "type": "object" },
    "results": { "type": "object" },
    "repairEvidenceRequired": { "type": "boolean" },
    "repairAttempts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "assertion",
          "patchHash",
          "testOutcome",
          "buildOutcome",
          "reviewerOutcome",
          "noOpClassification",
          "costUsd",
          "latencyMs",
          "provider",
          "model"
        ],
        "properties": {
          "assertion": { "type": "string", "minLength": 1 },
          "patchHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "testOutcome": { "enum": ["PASS", "FAIL", "ERROR", "NOT_RUN", "UNKNOWN"] },
          "buildOutcome": { "enum": ["PASS", "FAIL", "ERROR", "NOT_RUN", "UNKNOWN"] },
          "reviewerOutcome": { "enum": ["PASS", "FAIL", "ERROR", "NOT_RUN", "UNKNOWN"] },
          "noOpClassification": { "enum": ["NO_OP", "PATCH_APPLIED", "PATCH_REJECTED", "PATCH_FAILED"] },
          "costUsd": { "type": "number", "minimum": 0 },
          "latencyMs": { "type": "number", "exclusiveMinimum": 0 },
          "provider": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._:/-]*$" },
          "model": { "type": "string", "minLength": 1 }
        }
      }
    },
    "limitations": { "type": "array", "items": { "type": "string" } }
  },
  "$defs": {
    "identity": {
      "type": "object",
      "required": ["sha256"],
      "properties": { "sha256": { "type": ["string", "null"], "pattern": "^[a-f0-9]{64}$" }, "description": { "type": "string" } }
    }
  }
}
